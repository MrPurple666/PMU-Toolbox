<Window
    x:Class="ToolboxCorporativo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Raiz" Padding="32" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Toolbox Corporativo" Style="{StaticResource HeaderTextBlockStyle}" />
        <TextBlock Grid.Row="1" Text="Catálogo corporativo de recursos" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBox Width="360" Header="Servidor" Text="{Binding Onboarding.UrlApi, Mode=TwoWay}" />
            <Button VerticalAlignment="Bottom" Content="Sincronizar agora" Click="SincronizarClick" />
        </StackPanel>
        <TextBox Grid.Row="3" Header="Pesquisar recursos" Text="{Binding Catalogo.TextoPesquisa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />
        <TextBlock Grid.Row="4" Text="{Binding Onboarding.Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Grid.Row="5" Text="{Binding Onboarding.ErroTecnico}" TextWrapping="Wrap" Foreground="IndianRed" Margin="0,4,0,0" />
        <ListView Grid.Row="6" ItemsSource="{Binding Catalogo.Categorias}" Margin="0,8,0,0">
            <ListView.Header>
                <TextBlock Text="{Binding Catalogo.Mensagem}" TextWrapping="Wrap" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ListView ItemsSource="{Binding Recursos}" IsItemClickEnabled="True" ItemClick="RecursoClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,6">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Descricao}" Opacity="0.75" />
                                        <TextBlock Text="{Binding Destino}" Opacity="0.65" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
